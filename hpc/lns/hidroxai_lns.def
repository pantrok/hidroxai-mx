Bootstrap: docker
From: python:3.12-slim

# Contenedor para la ruta (c) de 01_entorno.sh: glibc del sistema < 2.17 o sin internet.
# Se construye fuera del LNS (Linux o WSL2 con Apptainer) y se sube a $HOME/envs/hidroxai.sif:
#   apptainer build hidroxai.sif hpc/lns/hidroxai_lns.def
# Mismas versiones que el estudio en CPU.

%post
    pip install --no-cache-dir "torch==2.14.1" --index-url https://download.pytorch.org/whl/cpu
    pip install --no-cache-dir "numpy==2.4.6" "pandas==3.0.3" "pyarrow==24.0.0" "captum==0.9.0" pyyaml

%environment
    export PYTHONUTF8=1
